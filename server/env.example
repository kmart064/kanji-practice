NODE_ENV=development
PORT=3001
LOG_FILE_PATH=./logs/error.log

# Number of words to generate sentences for per request. Default: 10.
CARDS_PER_CYCLE=10

GROQ_API_KEY=

# Number of days between reviews for correctly remembered words.
# The interval increases with each SRS level.
SRS_SCHEDULE=0 1 3 4 7 14 30 100 200 365

SUPABASE_DB_URL=postgresql://postgres...pooler.supabase.com:6543/postgres

ACCESS_SECRET=
REFRESH_SECRET=

# Minimum SRS level required for a word to be included in a review session.
# Level 0 is a new word; forgetting a word resets it to level 0.
REQUIRED_STAGE_REVIEWS=2

# Maximum number of words outside the required set to add to the review.
NONREQUIRED_REVIEW_LIMIT=100

# Maximum number of words that can be reviewed in a session.
HARD_LIMIT=75

# Maximum number of hours between consecutive reviews for them to count toward a streak.
STREAK_LIMIT=36

# Number of days included in the displayed statistics.
# 13 days corresponds to a two-week period when including the current day.
STATS_PERIOD_DAYS=13

# If true, authentication is required for all server API calls.
# Set to false when running locally without authentication.
AUTH_ENABLED=false